CREATE SCHEMA PUBLIC AUTHORIZATION DBA
CREATE MEMORY TABLE PUBLIC.TWORKORDERS(ID VARCHAR(255) NOT NULL PRIMARY KEY,AMOUNT DOUBLE,CREATEDAT TIMESTAMP,DATE TIMESTAMP,DESCRIPTION VARCHAR(255),ENTITYSTATE VARCHAR(255),STATE VARCHAR(255),UPDATEDAT TIMESTAMP,VERSION BIGINT,INVOICE_ID VARCHAR(255),MECHANIC_ID VARCHAR(255),VEHICLE_ID VARCHAR(255),CONSTRAINT UNQ_TWORKORDERS_0 UNIQUE(DATE,VEHICLE_ID))
CREATE MEMORY TABLE PUBLIC.TCHARGES(ID VARCHAR(255) NOT NULL PRIMARY KEY,AMOUNT DOUBLE,CREATEDAT TIMESTAMP,ENTITYSTATE VARCHAR(255),UPDATEDAT TIMESTAMP,VERSION BIGINT,INVOICE_ID VARCHAR(255),PAYMENTMEAN_ID VARCHAR(255),CONSTRAINT UNQ_TCHARGES_0 UNIQUE(INVOICE_ID,PAYMENTMEAN_ID))
CREATE MEMORY TABLE PUBLIC.TINTERVENTIONS(ID VARCHAR(255) NOT NULL PRIMARY KEY,CREATEDAT TIMESTAMP,DATE TIMESTAMP,ENTITYSTATE VARCHAR(255),MINUTES INTEGER,UPDATEDAT TIMESTAMP,VERSION BIGINT,MECHANIC_ID VARCHAR(255),WORKORDER_ID VARCHAR(255),CONSTRAINT UNQ_TINTERVENTIONS_0 UNIQUE(WORKORDER_ID,MECHANIC_ID,DATE),CONSTRAINT FK_TINTERVENTIONS_WORKORDER_ID FOREIGN KEY(WORKORDER_ID) REFERENCES PUBLIC.TWORKORDERS(ID))
CREATE MEMORY TABLE PUBLIC.TPAYMENTMEANS(ID VARCHAR(255) NOT NULL PRIMARY KEY,DTYPE VARCHAR(31),ACCUMULATED DOUBLE,CREATEDAT TIMESTAMP,ENTITYSTATE VARCHAR(255),UPDATEDAT TIMESTAMP,VERSION BIGINT,CLIENT_ID VARCHAR(255))
CREATE MEMORY TABLE PUBLIC.TCLIENTS(ID VARCHAR(255) NOT NULL PRIMARY KEY,CREATEDAT TIMESTAMP,EMAIL VARCHAR(255),ENTITYSTATE VARCHAR(255),NAME VARCHAR(255),NIF VARCHAR(255),PHONE VARCHAR(255),SURNAME VARCHAR(255),UPDATEDAT TIMESTAMP,VERSION BIGINT,CITY VARCHAR(255),STREET VARCHAR(255),ZIPCODE VARCHAR(255),CONSTRAINT UNQ_TCLIENTS_5 UNIQUE(NIF))
CREATE MEMORY TABLE PUBLIC.TSUBSTITUTIONS(ID VARCHAR(255) NOT NULL PRIMARY KEY,CREATEDAT TIMESTAMP,ENTITYSTATE VARCHAR(255),PRICE DOUBLE,QUANTITY INTEGER,UPDATEDAT TIMESTAMP,VERSION BIGINT,INTERVENTION_ID VARCHAR(255),SPAREPART_ID VARCHAR(255),CONSTRAINT UNQ_TSUBSTITUTIONS_0 UNIQUE(SPAREPART_ID,INTERVENTION_ID),CONSTRAINT FK_TSUBSTITUTIONS_INTERVENTION_ID FOREIGN KEY(INTERVENTION_ID) REFERENCES PUBLIC.TINTERVENTIONS(ID))
CREATE MEMORY TABLE PUBLIC.TCREDITCARDS(ID VARCHAR(255) NOT NULL PRIMARY KEY,NUMBER VARCHAR(255),TYPE VARCHAR(255),VALIDTHRU DATE,CONSTRAINT UNQ_TCREDITCARDS_1 UNIQUE(NUMBER),CONSTRAINT FK_TCREDITCARDS_ID FOREIGN KEY(ID) REFERENCES PUBLIC.TPAYMENTMEANS(ID))
CREATE MEMORY TABLE PUBLIC.TPAYROLLS(ID VARCHAR(255) NOT NULL PRIMARY KEY,BASESALARY DOUBLE,CREATEDAT TIMESTAMP,DATE DATE,ENTITYSTATE VARCHAR(255),EXTRASALARY DOUBLE,NICDEDUCTION DOUBLE,PRODUCTIVITYEARNING DOUBLE,TAXDEDUCTION DOUBLE,TRIENNIUMEARNING DOUBLE,UPDATEDAT TIMESTAMP,VERSION BIGINT,CONTRACT_ID VARCHAR(255),CONSTRAINT UNQ_TPAYROLLS_0 UNIQUE(CONTRACT_ID,DATE))
CREATE MEMORY TABLE PUBLIC.TINVOICES(ID VARCHAR(255) NOT NULL PRIMARY KEY,AMOUNT DOUBLE,CREATEDAT TIMESTAMP,DATE DATE,ENTITYSTATE VARCHAR(255),NUMBER BIGINT,STATE VARCHAR(255),UPDATEDAT TIMESTAMP,VAT DOUBLE,VERSION BIGINT,CONSTRAINT UNQ_TINVOICES_5 UNIQUE(NUMBER))
CREATE MEMORY TABLE PUBLIC.TPROFESSIONALGROUPS(ID VARCHAR(255) NOT NULL PRIMARY KEY,CREATEDAT TIMESTAMP,ENTITYSTATE VARCHAR(255),NAME VARCHAR(255),PRODUCTIVITYRATE DOUBLE,TRIENNIUMPAYMENT DOUBLE,UPDATEDAT TIMESTAMP,VERSION BIGINT,CONSTRAINT UNQ_TPROFESSIONALGROUPS_3 UNIQUE(NAME))
CREATE MEMORY TABLE PUBLIC.TCONTRACTTYPES(ID VARCHAR(255) NOT NULL PRIMARY KEY,COMPENSATIONDAYSPERYEAR DOUBLE,CREATEDAT TIMESTAMP,ENTITYSTATE VARCHAR(255),NAME VARCHAR(255),UPDATEDAT TIMESTAMP,VERSION BIGINT,CONSTRAINT UNQ_TCONTRACTTYPES_4 UNIQUE(NAME))
CREATE MEMORY TABLE PUBLIC.TVEHICLETYPES(ID VARCHAR(255) NOT NULL PRIMARY KEY,CREATEDAT TIMESTAMP,ENTITYSTATE VARCHAR(255),NAME VARCHAR(255),PRICEPERHOUR DOUBLE,UPDATEDAT TIMESTAMP,VERSION BIGINT,CONSTRAINT UNQ_TVEHICLETYPES_3 UNIQUE(NAME))
CREATE MEMORY TABLE PUBLIC.TSPAREPARTS(ID VARCHAR(255) NOT NULL PRIMARY KEY,CODE VARCHAR(255),CREATEDAT TIMESTAMP,DESCRIPTION VARCHAR(255),ENTITYSTATE VARCHAR(255),MAXSTOCK INTEGER,MINSTOCK INTEGER,PRICE DOUBLE,STOCK INTEGER,UPDATEDAT TIMESTAMP,VERSION BIGINT,CONSTRAINT UNQ_TSPAREPARTS_1 UNIQUE(CODE))
CREATE MEMORY TABLE PUBLIC.TVEHICLES(ID VARCHAR(255) NOT NULL PRIMARY KEY,CREATEDAT TIMESTAMP,ENTITYSTATE VARCHAR(255),MAKE VARCHAR(255),MODEL VARCHAR(255),PLATENUMBER VARCHAR(255),UPDATEDAT TIMESTAMP,VERSION BIGINT,CLIENT_ID VARCHAR(255),VEHICLETYPE_ID VARCHAR(255),CONSTRAINT UNQ_TVEHICLES_5 UNIQUE(PLATENUMBER),CONSTRAINT FK_TVEHICLES_VEHICLETYPE_ID FOREIGN KEY(VEHICLETYPE_ID) REFERENCES PUBLIC.TVEHICLETYPES(ID),CONSTRAINT FK_TVEHICLES_CLIENT_ID FOREIGN KEY(CLIENT_ID) REFERENCES PUBLIC.TCLIENTS(ID))
CREATE MEMORY TABLE PUBLIC.TMECHANICS(ID VARCHAR(255) NOT NULL PRIMARY KEY,CREATEDAT TIMESTAMP,ENTITYSTATE VARCHAR(255),NAME VARCHAR(255),NIF VARCHAR(255),SURNAME VARCHAR(255),UPDATEDAT TIMESTAMP,VERSION BIGINT,CONSTRAINT UNQ_TMECHANICS_4 UNIQUE(NIF))
CREATE MEMORY TABLE PUBLIC.TCASHES(ID VARCHAR(255) NOT NULL PRIMARY KEY,CONSTRAINT FK_TCASHES_ID FOREIGN KEY(ID) REFERENCES PUBLIC.TPAYMENTMEANS(ID))
CREATE MEMORY TABLE PUBLIC.TCONTRACTS(ID VARCHAR(255) NOT NULL PRIMARY KEY,ANNUALBASESALARY DOUBLE,CREATEDAT TIMESTAMP,ENDDATE DATE,ENTITYSTATE VARCHAR(255),SETTLEMENT DOUBLE,STARTDATE DATE,STATE VARCHAR(255),TAXRATE DOUBLE,UPDATEDAT TIMESTAMP,VERSION BIGINT,CONTRACTTYPE_ID VARCHAR(255),MECHANIC_ID VARCHAR(255),PROFESSIONALGROUP_ID VARCHAR(255),CONSTRAINT FK_TCONTRACTS_PROFESSIONALGROUP_ID FOREIGN KEY(PROFESSIONALGROUP_ID) REFERENCES PUBLIC.TPROFESSIONALGROUPS(ID),CONSTRAINT FK_TCONTRACTS_MECHANIC_ID FOREIGN KEY(MECHANIC_ID) REFERENCES PUBLIC.TMECHANICS(ID),CONSTRAINT FK_TCONTRACTS_CONTRACTTYPE_ID FOREIGN KEY(CONTRACTTYPE_ID) REFERENCES PUBLIC.TCONTRACTTYPES(ID))
CREATE MEMORY TABLE PUBLIC.TVOUCHERS(ID VARCHAR(255) NOT NULL PRIMARY KEY,AVAILABLE DOUBLE,CODE VARCHAR(255),DESCRIPTION VARCHAR(255),CONSTRAINT UNQ_TVOUCHERS_2 UNIQUE(CODE),CONSTRAINT FK_TVOUCHERS_ID FOREIGN KEY(ID) REFERENCES PUBLIC.TPAYMENTMEANS(ID))
ALTER TABLE PUBLIC.TWORKORDERS ADD CONSTRAINT FK_TWORKORDERS_INVOICE_ID FOREIGN KEY(INVOICE_ID) REFERENCES PUBLIC.TINVOICES(ID)
ALTER TABLE PUBLIC.TWORKORDERS ADD CONSTRAINT FK_TWORKORDERS_VEHICLE_ID FOREIGN KEY(VEHICLE_ID) REFERENCES PUBLIC.TVEHICLES(ID)
ALTER TABLE PUBLIC.TWORKORDERS ADD CONSTRAINT FK_TWORKORDERS_MECHANIC_ID FOREIGN KEY(MECHANIC_ID) REFERENCES PUBLIC.TMECHANICS(ID)
ALTER TABLE PUBLIC.TCHARGES ADD CONSTRAINT FK_TCHARGES_PAYMENTMEAN_ID FOREIGN KEY(PAYMENTMEAN_ID) REFERENCES PUBLIC.TPAYMENTMEANS(ID)
ALTER TABLE PUBLIC.TCHARGES ADD CONSTRAINT FK_TCHARGES_INVOICE_ID FOREIGN KEY(INVOICE_ID) REFERENCES PUBLIC.TINVOICES(ID)
ALTER TABLE PUBLIC.TINTERVENTIONS ADD CONSTRAINT FK_TINTERVENTIONS_MECHANIC_ID FOREIGN KEY(MECHANIC_ID) REFERENCES PUBLIC.TMECHANICS(ID)
ALTER TABLE PUBLIC.TPAYMENTMEANS ADD CONSTRAINT FK_TPAYMENTMEANS_CLIENT_ID FOREIGN KEY(CLIENT_ID) REFERENCES PUBLIC.TCLIENTS(ID)
ALTER TABLE PUBLIC.TSUBSTITUTIONS ADD CONSTRAINT FK_TSUBSTITUTIONS_SPAREPART_ID FOREIGN KEY(SPAREPART_ID) REFERENCES PUBLIC.TSPAREPARTS(ID)
ALTER TABLE PUBLIC.TPAYROLLS ADD CONSTRAINT FK_TPAYROLLS_CONTRACT_ID FOREIGN KEY(CONTRACT_ID) REFERENCES PUBLIC.TCONTRACTS(ID)
